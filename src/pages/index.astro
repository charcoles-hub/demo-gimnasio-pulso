---
const img = (f: string) => `${import.meta.env.BASE_URL}/img/${f}`.replace("//", "/");
const franjas = [
  { h: "7:00", d: ["HIIT despierta", "—", "HIIT despierta", "—", "HIIT despierta", "—", ""] },
  { h: "9:30", d: ["—", "Cross training", "—", "Cross training", "—", "Open box", ""] },
  { h: "13:30", d: ["Express 30", "Express 30", "Express 30", "Express 30", "Express 30", "Ciclo indoor", ""] },
  { h: "18:00", d: ["Body pump", "Ciclo indoor", "Body pump", "Ciclo indoor", "—", "", ""] },
  { h: "19:00", d: ["Boxeo", "Fuerza guiada", "Boxeo", "Fuerza guiada", "Boxeo", "", ""] },
  { h: "20:00", d: ["—", "—", "Yoga", "—", "Movilidad", "", ""] },
];
const dias = ["Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom"];
const cuotas = [
  { n: "Mensual", p: "29", per: "/mes", f: ["Acceso total 6–24h", "Todas las clases", "Sin permanencia"], star: false },
  { n: "Trimestral", p: "75", per: "/3 meses", f: ["Ahorras 12 €", "Todas las clases", "1 sesión PT gratis"], star: true },
  { n: "Anual", p: "260", per: "/año", f: ["Ahorras 88 €", "Todas las clases", "Plan nutricional"], star: false },
];
const reviews = [
  { n: "Iker A.", a: "I", t: "hace 3 semanas", q: "Llevo medio año y no he vuelto a pisar otro gimnasio. Nunca está petado, ni a las 19:00, y las clases de boxeo son una pasada." },
  { n: "Nerea L.", a: "N", t: "hace 1 mes", q: "Me apunté con la semana gratis y me quedé. Los entrenadores se saben tu nombre y te corrigen la técnica sin que se lo pidas." },
  { n: "Unai G.", a: "U", t: "hace 2 semanas", q: "Abierto hasta las 12 de la noche, que con mis turnos es oro. Material nuevo y duchas siempre limpias." },
];
const feats = [
  { t: "Sala de fuerza", d: "Peso libre hasta 50 kg, siete racks y plataformas de halterofilia.", i: "M3 9h2v6H3zM19 9h2v6h-2zM6 6h2.5v12H6zM15.5 6H18v12h-2.5zM9.5 11h5v2h-5z" },
  { t: "Clases dirigidas", d: "HIIT, ciclo, boxeo, body pump y yoga, cada semana en el cuadro.", i: "M13 2 4.5 13.5H11L9.5 22 19 9.5h-6.5L13 2z" },
  { t: "Entrenadores", d: "Plan inicial gratuito y seguimiento real, no una tabla impresa.", i: "M12 3a4 4 0 1 1 0 8 4 4 0 0 1 0-8zm-7 17a7 7 0 0 1 14 0v1H5v-1z" },
  { t: "Abierto 6–24h", d: "Todos los días del año. Entrena cuando te encaje a ti.", i: "M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20zm1 5h-2v6l4.5 2.7 1-1.7-3.5-2V7z" },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Pulso · Gimnasio en Bilbao, en Gran Vía 30 junto a Moyúa. Sala de fuerza, clases dirigidas y entrenadores, abierto de 6:00 a 24:00. Primera semana gratis." />
    <title>Pulso · Gimnasio en Bilbao · Semana gratis</title>
    <meta name="theme-color" content="#0c0e0a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Pulso · Gimnasio en Bilbao" />
    <meta property="og:description" content="Sala de fuerza, clases dirigidas y entrenadores de verdad. Abierto 6–24h en Gran Vía 30. Primera semana gratis." />
    <meta property="og:image" content="https://charcoles-hub.github.io/demo-gimnasio-pulso/img/og.jpg" />
    <meta property="og:url" content="https://charcoles-hub.github.io/demo-gimnasio-pulso/" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`.replace("//","/")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="bar">
      <a href="#top" class="wordmark">PULSO<span>.</span></a>
      <nav class="bar-nav">
        <a href="#sala">La sala</a>
        <a href="#horario">Horario de clases</a>
        <a href="#cuotas">Cuotas</a>
      </nav>
      <a href="#apuntate" class="btn btn-sm">Semana gratis</a>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Gimnasio · Bilbao · Gran Vía 30</p>
          <h1>Tu mejor versión empieza <em>hoy.</em></h1>
          <p class="lead">Sala de fuerza seria, clases que enganchan y entrenadores que se saben tu nombre. Abierto de 6:00 a 24:00, todos los días.</p>
          <div class="hero-cta">
            <a href="#apuntate" class="btn">Probar una semana gratis</a>
            <a href="#horario" class="link-arrow">Ver el horario →</a>
          </div>
          <p class="hero-fact">Sin permanencia · Sin matrícula este mes</p>
        </div>
        <div class="hero-frame">
          <img src={img("entreno.webp")} alt="Peso muerto visto desde arriba sobre el suelo de goma de la sala" width="1400" height="934" fetchpriority="high" decoding="async" />
        </div>
      </section>

      <section id="sala" class="feats">
        <ul class="feat-grid">
          {feats.map((f) => (
            <li class="feat" data-reveal>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={f.i}/></svg>
              <h3>{f.t}</h3>
              <p>{f.d}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="horario" class="horario">
        <header class="sec-head">
          <p class="eyebrow">El cuadro de la semana</p>
          <h2>Clases dirigidas, <em>todas incluidas.</em></h2>
        </header>
        <div class="tabla-wrap" data-reveal>
          <table class="tabla">
            <thead>
              <tr>
                <th scope="col"><span class="visually-hidden">Hora</span></th>
                {dias.map((d) => <th scope="col">{d}</th>)}
              </tr>
            </thead>
            <tbody>
              {franjas.map((f) => (
                <tr>
                  <th scope="row">{f.h}</th>
                  {f.d.map((c) => <td class={c === "—" || c === "" ? "off" : "on"}>{c === "—" ? "·" : c === "" ? "·" : c}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="tabla-foot">Domingo la sala abre igual, de 6:00 a 24:00. Plazas por orden de llegada, sin reservar.</p>
      </section>

      <section id="cuotas" class="cuotas">
        <header class="sec-head center">
          <p class="eyebrow">Cuotas</p>
          <h2>Precio claro. <em>Sin letra pequeña.</em></h2>
        </header>
        <ul class="planes">
          {cuotas.map((c) => (
            <li class={`plan${c.star ? " is-star" : ""}`} data-reveal>
              {c.star && <span class="tag">La más elegida</span>}
              <h3>{c.n}</h3>
              <p class="precio">{c.p}<small>€{c.per}</small></p>
              <ul>
                {c.f.map((x) => <li>{x}</li>)}
              </ul>
              <a href="#apuntate" class={c.star ? "btn btn-block" : "btn btn-ghost btn-block"}>Apuntarme</a>
            </li>
          ))}
        </ul>
      </section>

      <section class="quote">
        <header class="sec-head center">
          <p class="eyebrow">Lo que dicen</p>
          <h2>4,7 sobre 5 <em>en Google</em></h2>
          <p class="reviews-count">168 reseñas · Bilbao</p>
        </header>
        <ul class="reviews">
          {reviews.map((r) => (
            <li class="review" data-reveal>
              <div class="review-head">
                <span class="avatar" aria-hidden="true">{r.a}</span>
                <div>
                  <strong>{r.n}</strong>
                  <span class="review-meta">{r.t}</span>
                </div>
              </div>
              <div class="stars" aria-label="5 de 5 estrellas">★★★★★</div>
              <p>{r.q}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="apuntate" class="visita">
        <div class="visita-info">
          <p class="eyebrow">Ven a probar</p>
          <h2>Primera semana <em>gratis.</em></h2>
          <dl class="facts">
            <div><dt>Dónde</dt><dd>Gran Vía 30<br/>48009 Bilbao<br/><span class="fact-extra">Metro Moyúa, salida Gran Vía · a 1 min</span></dd></div>
            <div><dt>Horario</dt><dd>Lun–Dom · 6:00 – 24:00<br/><span class="fact-extra">Recepción de 9:00 a 21:00</span></dd></div>
            <div><dt>Contacto</dt><dd><a href="tel:+34600777888">+34 600 777 888</a><br/><a href="https://wa.me/34600777888">WhatsApp</a> · <a href="mailto:hola@gimnasiopulso.es">hola@gimnasiopulso.es</a></dd></div>
          </dl>
          <a class="mapa" href="https://www.google.com/maps/search/?api=1&query=Gran+V%C3%ADa+30+Bilbao" target="_blank" rel="noopener">
            <img src={img("mapa.webp")} alt="Mapa del centro de Bilbao con el gimnasio señalado en Gran Vía" width="768" height="520" loading="lazy" decoding="async" />
            <span class="mapa-cta">Cómo llegar →</span>
          </a>
        </div>
        <form class="visita-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="TU-ACCESS-KEY-WEB3FORMS" />
          <input type="hidden" name="subject" value="Semana gratis — Pulso" />
          <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" />
          <h3>Reserva tu semana gratis</h3>
          <label>Nombre<input name="name" required autocomplete="name" /></label>
          <label>Teléfono<input name="phone" required autocomplete="tel" inputmode="tel" /></label>
          <label>¿Qué te interesa?
            <select name="objetivo">
              <option>Fuerza</option>
              <option>Clases dirigidas</option>
              <option>Perder peso</option>
              <option>Ponerme en forma en general</option>
            </select>
          </label>
          <button type="submit" class="btn btn-block">Reservar mi semana</button>
          <p class="form-note">Te escribimos por WhatsApp para darte cita el mismo día.</p>
        </form>
      </section>
    </main>

    <nav class="dock" aria-label="Contacto rápido">
      <a href="tel:+34600777888"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11 11 0 0 0 3.5.56 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11 11 0 0 0 .56 3.5 1 1 0 0 1-.25 1z"/></svg>Llamar</a>
      <a href="https://wa.me/34600777888"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .1-1.6-.1a13 13 0 0 1-5-3.3 9.4 9.4 0 0 1-2-3.2c-.2-.7 0-1.3.4-1.7l.6-.6c.2-.2.5-.2.7.1l1 1.7c.1.3.1.5 0 .7l-.4.5c-.2.2-.2.4-.1.6a7.6 7.6 0 0 0 3.4 3c.3.1.5.1.7-.1l.6-.7c.2-.2.4-.2.7-.1l1.7.9c.3.1.4.4.3.7z"/></svg>WhatsApp</a>
      <a href="#apuntate" class="dock-cta">Semana gratis</a>
    </nav>

    <footer class="foot">
      <span class="wordmark sm">PULSO<span>.</span></span>
      <p>Gimnasio · Gran Vía 30, Bilbao · 6:00–24:00</p>
      <div class="foot-social">
        <a href="#">Instagram</a><a href="#">TikTok</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --negro: #0c0e0a;
    --negro-2: #14170f;
    --volt: #c6f024;
    --volt-fuerte: #a8cf14;
    --blanco: #f2f4ea;
    --muted: #9aa08a;
    --line: #262b1d;
    --display: "Anton", "Arial Narrow", system-ui, sans-serif;
    --ui: "Space Grotesk", system-ui, sans-serif;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--negro); color: var(--blanco);
    font-family: var(--ui); font-size: 17px; line-height: 1.6;
    -webkit-font-smoothing: antialiased; overflow-x: hidden;
  }
  ::selection { background: var(--volt); color: var(--negro); }
  a { color: inherit; text-decoration: none; }
  em { font-style: normal; color: var(--volt); }

  .bar {
    position: sticky; top: 0; z-index: 30;
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px clamp(24px, 6vw, 80px);
    background: color-mix(in srgb, var(--negro) 86%, transparent);
    backdrop-filter: blur(10px); border-bottom: 1px solid var(--line);
  }
  .wordmark { font-family: var(--display); font-size: 26px; letter-spacing: .04em; }
  .wordmark span { color: var(--volt); }
  .wordmark.sm { font-size: 22px; }
  .bar-nav { display: flex; gap: 32px; font-size: 15px; }
  .bar-nav a { color: var(--muted); transition: color .25s; }
  .bar-nav a:hover { color: var(--blanco); }

  .btn {
    display: inline-block; font-weight: 700; font-size: 15px; text-align: center;
    padding: 14px 28px; border-radius: 4px; text-transform: uppercase; letter-spacing: .05em;
    background: var(--volt); color: var(--negro); border: 1px solid var(--volt);
    transition: background .25s, transform .5s linear(0, .55 18%, 1.04 42%, .98 60%, 1), box-shadow .3s;
  }
  .btn:hover { background: var(--volt-fuerte); transform: translateY(-3px); box-shadow: 0 12px 26px -12px rgba(198,240,36,.5); }
  .btn-sm { padding: 10px 18px; font-size: 13px; }
  .btn-block { width: 100%; padding: 16px; }
  .btn-ghost { background: transparent; color: var(--blanco); border-color: var(--line); }
  .btn-ghost:hover { background: var(--negro-2); box-shadow: none; }
  .link-arrow { font-weight: 700; border-bottom: 2px solid var(--line); padding-bottom: 2px; transition: border-color .25s; }
  .link-arrow:hover { border-color: var(--volt); }
  .eyebrow {
    font-size: 12px; letter-spacing: .3em; text-transform: uppercase;
    color: var(--volt); font-weight: 700; margin-bottom: 20px;
  }

  .hero {
    display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(30px, 5vw, 70px);
    align-items: center; min-height: 84vh;
    padding: clamp(40px, 7vw, 80px) clamp(24px, 6vw, 80px) 60px;
  }
  .hero h1 {
    font-family: var(--display); font-weight: 400; text-transform: uppercase;
    font-size: clamp(52px, 8.5vw, 110px); line-height: .96; letter-spacing: .01em;
    margin-bottom: 26px; max-width: 11ch;
  }
  .lead { max-width: 44ch; color: #c6cbb6; font-size: clamp(16px, 1.6vw, 19px); }
  .hero-cta { display: flex; align-items: center; gap: 26px; margin-top: 36px; flex-wrap: wrap; }
  .hero-fact { margin-top: 28px; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
  .hero-copy { animation: rise .9s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(26px); } }
  .hero-frame {
    aspect-ratio: 4/5; border-radius: 6px; overflow: hidden; position: relative;
    animation: rise 1.1s .15s cubic-bezier(.2,.7,.2,1) both;
    outline: 1px solid var(--line);
  }
  .hero-frame::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(200deg, rgba(198,240,36,.16), transparent 45%);
    mix-blend-mode: screen; pointer-events: none;
  }
  .hero-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }

  section { padding-left: clamp(24px, 6vw, 80px); padding-right: clamp(24px, 6vw, 80px); }
  .feats, .horario, .cuotas, .quote, .visita { padding-top: clamp(64px, 8vw, 110px); padding-bottom: clamp(64px, 8vw, 110px); }
  .sec-head { margin-bottom: 50px; max-width: 760px; }
  .sec-head.center { margin-inline: auto; text-align: center; }
  h2 {
    font-family: var(--display); font-weight: 400; text-transform: uppercase;
    font-size: clamp(34px, 4.8vw, 58px); line-height: 1.02; letter-spacing: .01em;
  }

  .feats { border-top: 1px solid var(--line); background: var(--negro-2); }
  .feat-grid { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(20px, 3vw, 40px); }
  .feat svg { width: 30px; height: 30px; color: var(--volt); margin-bottom: 14px; }
  .feat h3 { font-family: var(--display); font-weight: 400; text-transform: uppercase; font-size: 21px; letter-spacing: .02em; margin-bottom: 8px; }
  .feat p { color: var(--muted); font-size: 15px; }

  /* Horario */
  .horario { border-top: 1px solid var(--line); }
  .tabla-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 6px; -webkit-overflow-scrolling: touch; }
  .tabla { width: 100%; min-width: 760px; border-collapse: collapse; font-size: 14px; }
  .tabla th, .tabla td { padding: 13px 14px; text-align: left; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .tabla thead th {
    font-family: var(--display); font-weight: 400; letter-spacing: .06em; text-transform: uppercase;
    font-size: 15px; color: var(--volt); background: var(--negro-2); position: sticky; top: 0;
  }
  .tabla tbody th { font-weight: 700; color: var(--blanco); font-variant-numeric: tabular-nums; background: var(--negro-2); }
  .tabla td.on { font-weight: 500; }
  .tabla td.off { color: #3d4433; }
  .tabla tbody tr:last-child th, .tabla tbody tr:last-child td { border-bottom: 0; }
  .tabla-foot { color: var(--muted); font-size: 14px; margin-top: 18px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  /* Cuotas */
  .cuotas { background: var(--negro-2); border-top: 1px solid var(--line); }
  .planes { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; max-width: 1040px; margin-inline: auto; }
  .plan { background: var(--negro); border: 1px solid var(--line); border-radius: 6px; padding: 28px; position: relative; display: flex; flex-direction: column; }
  .plan.is-star { border-color: var(--volt); }
  .tag {
    position: absolute; top: -12px; left: 24px; font-size: 11px; letter-spacing: .12em; text-transform: uppercase;
    color: var(--negro); background: var(--volt); padding: 4px 10px; border-radius: 3px; font-weight: 700;
  }
  .plan h3 { font-family: var(--display); font-weight: 400; text-transform: uppercase; font-size: 20px; letter-spacing: .04em; }
  .precio { font-family: var(--display); font-size: 56px; line-height: 1.1; margin: 10px 0 16px; color: var(--volt); }
  .precio small { font-family: var(--ui); font-size: 15px; color: var(--muted); margin-left: 4px; }
  .plan ul { list-style: none; margin-bottom: 24px; flex: 1; }
  .plan ul li { padding: 7px 0 7px 24px; position: relative; font-size: 15px; color: #c6cbb6; }
  .plan ul li::before { content: "✓"; position: absolute; left: 0; color: var(--volt); font-weight: 700; }

  /* Reseñas */
  .quote { text-align: center; border-top: 1px solid var(--line); }
  .reviews-count { color: var(--muted); font-size: 14px; margin-top: 10px; }
  .reviews {
    list-style: none; display: grid; gap: 18px; grid-template-columns: repeat(3, 1fr);
    max-width: 1040px; margin-inline: auto; text-align: left;
  }
  .review { background: var(--negro-2); border: 1px solid var(--line); border-radius: 6px; padding: 22px 24px; }
  .review-head { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
  .review-head strong { display: block; font-size: 15px; }
  .avatar {
    width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center;
    background: var(--volt); color: var(--negro); font-weight: 700; flex: none;
  }
  .review-meta { font-size: 12.5px; color: var(--muted); }
  .stars { color: #f4b400; letter-spacing: 2px; font-size: 15px; margin-bottom: 8px; }
  .review p { font-size: 15.5px; color: #c6cbb6; }

  /* Visita */
  .visita { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 6vw, 90px); align-items: start; background: var(--negro-2); border-top: 1px solid var(--line); }
  .facts { margin-top: 36px; display: grid; gap: 24px; }
  .facts dt { font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--volt); margin-bottom: 6px; font-weight: 700; }
  .facts dd { line-height: 1.5; }
  .fact-extra { color: var(--muted); font-size: 14px; }
  .facts a { border-bottom: 1px solid color-mix(in srgb, var(--volt) 45%, transparent); font-weight: 500; }
  .facts a:hover { color: var(--volt); }
  .mapa { display: block; position: relative; margin-top: 30px; border-radius: 6px; overflow: hidden; border: 1px solid var(--line); }
  .mapa img { display: block; width: 100%; height: 230px; object-fit: cover; }
  .mapa-cta {
    position: absolute; right: 14px; bottom: 14px; background: var(--volt); color: var(--negro);
    font-size: 13px; font-weight: 700; padding: 9px 15px; border-radius: 4px;
  }
  .mapa:hover .mapa-cta { background: var(--volt-fuerte); }
  .visita-form { background: var(--negro); border: 1px solid var(--line); border-radius: 6px; padding: clamp(26px, 3vw, 40px); }
